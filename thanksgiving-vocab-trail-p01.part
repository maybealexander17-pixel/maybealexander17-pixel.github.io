.badge{display:inline-flex;align-items:center;justify-content:center;background:var(--paper);color:var(--rust);border:1px solid var(--rust);font:800 .8rem/1 var(--body);min-width:34px;height:34px;padding:0 6px}
.tb{width:36px;height:36px}.total .tb{font-size:1rem;border:2px double var(--rust);width:46px;height:46px;transform:rotate(-3deg)}
.navrail{position:sticky;top:0;z-index:30;background:color-mix(in oklch,var(--paper) 94%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--pale);padding:10px 0}
#nav{display:grid;grid-template-columns:repeat(8,minmax(92px,1fr));gap:6px;overflow-x:auto;padding:3px 2px 8px;scrollbar-width:thin}
#nav button{position:relative;min-height:48px;border:0;border-top:2px solid var(--pale);background:transparent;padding:8px 4px 4px;text-align:left;font:700 .76rem/1.2 var(--body)}
#nav button:hover{border-color:var(--rust)}#nav button.on{border-color:var(--rust);color:var(--rust-dark)}#nav button.done{border-color:var(--good)}
#nav button .tb{position:absolute;right:2px;top:5px;min-width:25px;width:25px;height:25px;border:0;background:var(--pale);font-size:.66rem;color:var(--muted)}
#nav button.on .tb{background:var(--rust);color:var(--paper)}#nav button.done .tb{background:var(--good-bg);color:var(--good)}
.bar{display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid var(--pale);padding-top:9px}
.btn{min-height:44px;border:1px solid var(--rust-dark);background:var(--rust);color:var(--paper);padding:10px 17px;font:800 .84rem/1.2 var(--body);transition:transform .15s,background .15s}
.btn:hover:not(:disabled){background:var(--rust-dark);transform:translateY(-1px)}.btn:active:not(:disabled){transform:translateY(1px)}
.btn.ghost{background:var(--paper);color:var(--rust-dark);border-color:var(--rust)}.btn.ghost:hover:not(:disabled){background:var(--pale)}
.btn.blue{background:var(--blue);border-color:var(--blue)}.btn.sm{padding:8px 13px;font-size:.78rem;min-height:40px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.mute{color:var(--muted)}.small{font-size:.85rem}.hand{font-family:var(--hand)}.okc{color:var(--good);font-weight:800}
.card{background:color-mix(in oklch,var(--paper) 94%,transparent);border-top:1px solid var(--gold);border-bottom:1px solid var(--pale);padding:17px 18px;margin:12px 0}
.card.solved{background:color-mix(in oklch,var(--good-bg) 70%,transparent);border-top-color:var(--good)}
.fb{margin-top:10px;font-size:.92rem;min-height:20px}.fb.show{padding:10px 12px;background:var(--soft);border-left:2px solid var(--gold)}
.prog{height:5px;background:var(--pale);overflow:hidden;margin:8px 0}.prog i{display:block;height:100%;width:0;background:var(--rust);transition:width .25s ease-out}
.chip{display:inline-block;border:1px solid var(--blue);border-radius:2px;padding:8px 12px;background:var(--paper);color:var(--blue);font:700 .8rem/1.25 var(--body);cursor:pointer;min-height:42px;transition:transform .14s,background .14s}
.chip:hover:not(:disabled){background:var(--pale);transform:translateY(-1px)}.chip.sel{background:var(--blue);color:var(--paper)}.chip.off{opacity:.4;text-decoration:line-through;pointer-events:none}
input[type=text],textarea{width:100%;border:1px solid var(--blue);border-radius:0;padding:12px 13px;font:1rem/1.45 var(--body);background:color-mix(in oklch,var(--paper) 90%,white);color:var(--ink)}
textarea{min-height:150px;resize:vertical;font-family:var(--serif);line-height:1.7}input:focus,textarea:focus{border-color:var(--rust)}
mark{background:color-mix(in oklch,var(--gold) 30%,transparent);padding:0 2px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.shake{animation:shake .32s ease-out}@keyframes shake{25%{transform:translateX(-4px)}50%{transform:translateX(4px)}75%{transform:translateX(-2px)}}
.stage{padding:28px 0 18px;animation:rise .25s ease-out}@keyframes rise{from{opacity:0;transform:translateY(12px)}}
.shead{display:flex;gap:14px;align-items:flex-start;margin:4px 0 14px}.shead h2{font:700 clamp(1.8rem,4vw,2.6rem)/1.08 var(--display);margin:0 0 7px}.shead p{margin:0;color:var(--muted);max-width:70ch}