
/* stage-specific */
.fcard{position:relative;display:block;width:100%;min-height:150px;border:2px solid var(--line);border-radius:16px;background:var(--card);
  box-shadow:4px 4px 0 rgba(43,37,38,.16);cursor:pointer;perspective:600px;text-align:left;padding:0;transform-style:preserve-3d;transition:transform .35s}
.fcard .face{display:flex;flex-direction:column;gap:6px;padding:14px 16px;backface-visibility:hidden}
.fcard .front .c{font:700 20px/1.15 var(--display)}
.fcard .front .p{font:700 11px var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--teal)}
.fcard .front .hint{margin-top:auto;font:14px var(--hand);color:var(--mute)}
.fcard .back{position:absolute;inset:0;background:var(--hl);border-radius:14px;transform:rotateY(180deg)}
.fcard .back .m{font-size:14.5px;line-height:1.4}
.fcard .back .ru{color:var(--red-d);font-weight:800;font-size:14px}
.fcard .back .col{font-size:14px}
.fcard .back .nt{font:14px var(--hand);color:var(--mute)}
.fcard.flip{transform:rotateY(180deg)}
#art span.t{cursor:pointer;padding:0 1px;border-radius:3px}
#art span.t.f{background:linear-gradient(180deg,transparent 8%,var(--hl) 8%,var(--hl) 92%,transparent 92%);border-bottom-color:transparent}
.ru{direction:ltr}
.detail{min-height:64px}
@media (max-width:480px){
  .shead p{font-size:14px}
  .hero h1{font-size:clamp(30px,10vw,40px)}
}
</style>
</head>
<body>
<div class="drift" id="drift" aria-hidden="true"></div>
<div class="wrap">
  <header class="hero">
    <div class="total"><span class="badge tb" id="total">–</span><small id="totlab">badges left</small></div>
    <h1><span>We're Stuck</span><span>in Questions:</span><span>the Trail</span></h1>
    <div class="sub">20 phrases · 8 stages</div>
    <p class="by">Vocabulary from Albert Samaha's article in <i>New York</i> magazine. Clear every badge to finish. Start at the cards, end by saying it yourself.</p>
  </header>
  <div class="navrail">
    <nav id="nav" aria-label="Stages"></nav>
    <div class="bar">
      <button class="btn ghost sm" id="prev" type="button">← Back</button>
      <button class="btn ghost sm" id="mute" type="button" style="min-width:44px;min-height:44px">🔊</button>
      <button class="btn ghost sm" id="next" type="button">Next stage →</button>
    </div>
  </div>
  <main id="main"></main>
  <footer style="margin-top:26px;color:var(--mute);font-size:13px" class="hand">Your progress saves on this device. · @maybealexander1</footer>
</div>
<div class="toast" id="toast" hidden></div>
