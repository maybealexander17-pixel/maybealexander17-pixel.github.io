") format('woff2');font-weight:600 800;font-style:normal;font-display:swap}
:root{
  color-scheme:dark;
  --night:#071521;--navy:#0b1e2d;--navy2:#102a3b;--panel:#102635;--panel2:#142f40;
  --ice:#d8edef;--frost:#99d7dc;--blue:#7b9fb1;--muted:#9ab0ba;--line:#2a4654;
  --amber:#d9945b;--amber2:#f0b16f;--ember:#a94f45;--rose:#b77a80;
  --good:#9bd9cf;--bad:#efaaa3;--display:TrailDisplay,'Arial Narrow',sans-serif;
  --body:TrailBody,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --shadow:0 24px 70px rgba(0,0,0,.28);--radius:4px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--night);color:var(--ice);font:16px/1.65 var(--body);overflow-x:hidden}
button,textarea,input{font:inherit}
button{color:inherit}
a{color:var(--frost);text-underline-offset:3px}
a:hover{color:var(--ice)}
img,svg{display:block;max-width:100%}
[hidden]{display:none!important}
::selection{background:var(--frost);color:var(--night)}
:focus-visible{outline:2px solid var(--amber2);outline-offset:4px}
.skip{position:fixed;z-index:100;left:16px;top:12px;transform:translateY(-180%);background:var(--ice);color:var(--night);padding:10px 16px;text-decoration:none}
.skip:focus{transform:none}
.shell{width:min(1180px,calc(100% - 48px));margin-inline:auto;min-width:0}
.eyebrow{font:700 .78rem/1.2 var(--body);letter-spacing:.18em;text-transform:uppercase;color:var(--frost)}
.display{font-family:var(--display);text-transform:uppercase;letter-spacing:.035em;font-weight:700}
.muted{color:var(--muted)}
.small{font-size:.86rem}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

/* header */
.topbar{position:sticky;top:0;z-index:30;background:rgba(7,21,33,.9);border-bottom:1px solid rgba(153,215,220,.15);backdrop-filter:blur(14px)}
.topbar-inner{min-height:68px;display:flex;align-items:center;gap:22px}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--ice);white-space:nowrap}
.brand-mark{width:30px;height:30px;border:1px solid var(--frost);border-radius:50%;display:grid;place-items:center;font:700 18px/1 var(--display);color:var(--amber2)}
.brand-text{font:700 1.1rem/1 var(--display);letter-spacing:.09em;text-transform:uppercase}
.header-progress{margin-left:auto;display:flex;align-items:center;gap:12px;min-width:0}
.progress-track{width:120px;height:2px;background:var(--line);overflow:hidden}
.progress-fill{height:100%;width:0;background:var(--amber);transition:width .5s ease}
.save-state{font-size:.76rem;color:var(--muted);white-space:nowrap}
.save-state:before{content:'';display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--good);margin-right:7px;vertical-align:2px}