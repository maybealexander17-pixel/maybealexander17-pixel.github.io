R[6]=()=>{main.innerHTML=`<section class="stage">${head(7,'Use it yourself','Pick a prompt. Speak for 90 seconds, then write at least 80 words using three or more target chunks. The page listens for the chunks as you type.')}<div class="row" id="prompts" style="align-items:stretch"></div><div id="usebody"></div></section>`;S.use.order.forEach((qi,pos)=>{$('#prompts').insertAdjacentHTML('beforeend',`<button type="button" class="btn ${pos===S.use.cur?'':'ghost'} sm" data-p="${pos}">${S.use.done.includes(qi)?'✓ ':''}${qi+1}</button>`)});$$('[data-p]').forEach(b=>b.onclick=()=>{clearInterval(window._tm);S.use.cur=+b.dataset.p;save();R[6]()});const qi=S.use.order[S.use.cur],q=DATA.use[qi],hits=q.chunks.filter(t=>new RegExp(t[1],'i').test(norm(S.use.txt[qi]||''))).length,words=(S.use.txt[qi]||'').trim().split(/\s+/).filter(Boolean).length;$('#usebody').innerHTML=`<div class="usep">${esc(q.q)}</div><div class="row"><button type="button" class="btn sm" id="timer">Start 90-second timer</button><span class="hand" id="clock" style="font-size:1.7rem">1:30</span><span class="mute small" id="timerNote">Speak before you write. Notes are fine.</span></div><textarea class="in" id="writing" rows="8" placeholder="Write your answer here…">${esc(S.use.txt[qi]||'')}</textarea><div class="row"><span class="kicker" id="wc">${words} words</span><span class="mute small">80 words and 3 target chunks minimum</span></div><div class="targets" id="targets"></div><div class="row"><button type="button" class="btn sm" id="finish">Finish this response</button><button type="button" class="btn ghost sm" id="model">Model answer</button></div><div class="fb" id="fb"></div>`;
 const live=()=>{const v=$('#writing').value;S.use.txt[qi]=v;const w=v.trim().split(/\s+/).filter(Boolean).length,h=q.chunks.filter(t=>new RegExp(t[1],'i').test(norm(v))).length;$('#wc').textContent=w+' words';$('#targets').innerHTML=q.chunks.map(t=>`<span class="tg ${new RegExp(t[1],'i').test(norm(v))?'on':''}">${new RegExp(t[1],'i').test(norm(v))?'✓ ':''}${esc(t[0])}</span>`).join('');save();return{w,h}};live();$('#writing').oninput=live;$('#timer').onclick=()=>{clearInterval(window._tm);let left=90;$('#timer').disabled=true;$('#clock').textContent='1:30';$('#timerNote').textContent='Speaking time';window._tm=setInterval(()=>{left--;$('#clock').textContent=Math.floor(left/60)+':'+String(left%60).padStart(2,'0');if(left<=5&&left>0)SFX.play('tick');if(left<=0){clearInterval(window._tm);$('#timerNote').textContent='Time. Now write it up.';SFX.play('stage')}},FAST?10:1000)};$('#finish').onclick=()=>{const{w,h}=live(),fb=$('#fb');fb.classList.add('show');if(w<80){SFX.play('wrong');fb.textContent=`You have ${w} words. Add ${80-w} more so the ideas have room to develop.`}else if(h<3){SFX.play('wrong');fb.textContent=`You have ${h} target chunk${h===1?'':'s'}. Weave in at least ${3-h} more from this prompt.`}else{if(!S.use.done.includes(qi))S.use.done.push(qi);SFX.play('right');save();drawBadges();fb.innerHTML='<span class="okc">Saved. That response is yours.</span> Choose another prompt above, or move to the final retrieval stage.';R[6]();$('#fb').classList.add('show');$('#fb').innerHTML='<span class="okc">Saved. That response is yours.</span> Choose another prompt above, or move on.';if(S.use.done.length===5)celebrate('use')}};$('#model').onclick=()=>{const fb=$('#fb');fb.classList.add('show');fb.innerHTML=`<b>One possible answer:</b><p style="font:1rem/1.65 var(--serif)">${esc(q.model)}</p><span class="mute small">Do not copy it. Keep your own examples and opinion.</span>`}};

/* 8 · Final typed retrieval */