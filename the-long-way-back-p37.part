.icon-btn{border:1px solid var(--line);background:transparent;padding:8px 12px;cursor:pointer;font-size:.8rem;letter-spacing:.04em;transition:background .18s,border-color .18s}
.icon-btn:hover{background:var(--navy2);border-color:var(--blue)}

/* hero */
.hero{position:relative;isolation:isolate;min-height:690px;display:flex;align-items:flex-end;overflow:hidden;border-bottom:1px solid var(--line);background:#081925}
.hero-art{position:absolute;inset:0;width:100%;height:100%;z-index:-3;object-fit:cover}
.hero-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(4,13,21,.94) 0%,rgba(4,13,21,.72) 38%,rgba(4,13,21,.14) 72%),linear-gradient(0deg,#071521 0%,transparent 44%)}
.grain{position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.13;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E")}
.hero-content{padding:100px 0 82px;width:min(700px,100%)}
.hero-kicker{display:flex;align-items:center;gap:12px;margin-bottom:22px}
.hero-kicker:before{content:'';width:38px;height:1px;background:var(--amber)}
.hero h1{font-size:clamp(4.4rem,10vw,8.4rem);line-height:.8;margin:0;max-width:680px;text-wrap:balance}
.hero-sub{font-size:clamp(1.1rem,2vw,1.4rem);line-height:1.45;color:#bfd0d6;max-width:510px;margin:28px 0 32px}
.hero-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.btn{border:1px solid transparent;background:var(--amber);color:#101b21;padding:12px 19px;min-height:46px;cursor:pointer;font-weight:600;letter-spacing:.015em;display:inline-flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;transition:background .18s,transform .18s,border-color .18s}
.btn:hover{background:var(--amber2);transform:translateY(-1px)}
.btn.secondary{background:transparent;color:var(--ice);border-color:var(--line)}
.btn.secondary:hover{background:var(--navy2);border-color:var(--blue)}
.btn.ghost{background:transparent;color:var(--frost);border-color:transparent;padding-inline:8px}
.btn.ghost:hover{background:rgba(153,215,220,.06)}
.btn.small-btn{min-height:38px;padding:8px 13px;font-size:.87rem}
.btn:disabled{opacity:.42;cursor:not-allowed;transform:none}
.btn-arrow{font-size:1.15em;line-height:1}
.hero-note{font-size:.8rem;color:var(--muted);max-width:230px;line-height:1.5}
.hero-index{position:absolute;right:24px;bottom:36px;writing-mode:vertical-rl;font-size:.68rem;letter-spacing:.24em;color:rgba(216,237,239,.5);text-transform:uppercase}

/* route */
.route-section{padding:78px 0 56px;position:relative}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:28px}
.section-head h2{font-size:clamp(2.4rem,5vw,4.1rem);line-height:.92;margin:8px 0 0}
.route-summary{text-align:right;color:var(--muted);font-size:.9rem}
.route-summary strong{display:block;color:var(--ice);font-size:1.05rem;font-weight:600}
.map-shell{position:relative;height:430px;border:1px solid var(--line);background:var(--navy);overflow:hidden;box-shadow:var(--shadow)}
.map-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.8}
.map-title{position:absolute;left:24px;top:21px;z-index:2;font-size:.66rem;letter-spacing:.2em;color:var(--muted);text-transform:uppercase}
.map-key{position:absolute;right:22px;top:20px;display:flex;gap:16px;font-size:.72rem;color:var(--muted)}
.map-key span:before{content:'';display:inline-block;width:6px;height:6px;border:1px solid var(--blue);border-radius:50%;margin-right:6px}
.map-key .complete-key:before{background:var(--amber);border-color:var(--amber)}
.trail-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.trail-base{fill:none;stroke:#49616c;stroke-width:2;stroke-dasharray:3 8;stroke-linecap:round}
.trail-lit{fill:none;stroke:var(--amber);stroke-width:2.5;stroke-linecap:round;filter:drop-shadow(0 0 5px rgba(217,148,91,.5));transition:opacity .5s}