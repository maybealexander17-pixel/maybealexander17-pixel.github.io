function loadState(){try{return JSON.parse(localStorage.getItem(SAVE_KEY))}catch(e){return null}}
let saveT=null,resetting=false;
function save(){if(resetting)return;clearTimeout(saveT);saveT=setTimeout(()=>{if(resetting)return;try{localStorage.setItem(SAVE_KEY,JSON.stringify(S))}catch(e){}},300)}
function wipeState(){resetting=true;clearTimeout(saveT);try{localStorage.removeItem(SAVE_KEY)}catch(e){}}
function flushSave(){if(resetting)return;clearTimeout(saveT);try{localStorage.setItem(SAVE_KEY,JSON.stringify(S))}catch(e){}}
window.addEventListener('pagehide',flushSave);
document.addEventListener('visibilitychange',()=>{if(document.hidden)flushSave()});

/* ---------- SFX ---------- */
const SFX=(function(){
  let ctx=null,master=null,on=true,hushed=false;const log=[];
  try{on=localStorage.getItem('vp:sound')!=='off'}catch(e){}
  function ac(){if(!ctx){const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return null;try{ctx=new AC()}catch(e){return null}
    const comp=ctx.createDynamicsCompressor();comp.connect(ctx.destination);master=ctx.createGain();master.gain.value=.55;master.connect(comp)}
    if(ctx.state==='suspended'){try{ctx.resume()}catch(e){}}return ctx}
  function tone(f,at,dur,type,vol,slide){const c=ctx,t=c.currentTime+at,o=c.createOscillator(),g=c.createGain();o.type=type||'sine';o.frequency.setValueAtTime(f,t);
    if(slide)o.frequency.exponentialRampToValueAtTime(slide,t+dur);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(vol||.2,t+.012);g.gain.exponentialRampToValueAtTime(.0001,t+dur);
    o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+.05)}
  function noise(at,dur,vol,ft,f1,f2){const c=ctx,t=c.currentTime+at,len=Math.max(1,Math.floor(c.sampleRate*dur)),buf=c.createBuffer(1,len,c.sampleRate),d=buf.getChannelData(0);
    for(let i=0;i<len;i++)d[i]=Math.random()*2-1;const src=c.createBufferSource();src.buffer=buf;const fl=c.createBiquadFilter();fl.type=ft||'bandpass';fl.Q.value=1.2;fl.frequency.setValueAtTime(f1||1500,t);
    if(f2)fl.frequency.exponentialRampToValueAtTime(f2,t+dur);const g=c.createGain();g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(vol||.1,t+.01);g.gain.exponentialRampToValueAtTime(.0001,t+dur);
    src.connect(fl);fl.connect(g);g.connect(master);src.start(t);src.stop(t+dur+.05)}
  const SOUNDS={
    right:()=>{tone(1318,0,.14,'sine',.16);tone(1760,.09,.26,'sine',.14)},
    wrong:()=>{tone(220,0,.3,'sine',.12,165)},
    flip:()=>{noise(0,.09,.06,'highpass',2000,5000)},
    stage:()=>{[784,988,1175].forEach((f,i)=>tone(f,i*.1,.2,'sine',.11))},
    tick:()=>{tone(990,0,.05,'square',.05)},
    win:()=>{[659,784,988,1318,1568].forEach((f,i)=>tone(f,i*.08,i===4?.6:.15,'triangle',.11));for(let k=0;k<12;k++)tone(900+Math.random()*900,.35+Math.random()*1.1,.07,'sine',.05,1500)}
  };
  function play(n){if(!on||hushed||!SOUNDS[n])return;if(!ac())return;try{SOUNDS[n]();log.push(n)}catch(e){}}
  function set(v){on=v;try{localStorage.setItem('vp:sound',v?'on':'off')}catch(e){}}
  return {play,set,isOn:()=>on,hush:v=>{hushed=!!v},log};
})();
window.SFX=SFX;
function drawMute(){const b=$('#mute'),on=SFX.isOn();b.textContent=on?'🔊':'🔇';b.setAttribute('aria-pressed',on?'false':'true');b.setAttribute('aria-label',on?'Sound on. Tap to mute.':'Sound off. Tap to turn on.')}
drawMute();$('#mute').onclick=()=>{SFX.set(!SFX.isOn());drawMute();if(SFX.isOn())SFX.play('flip')};
$('#reset').onclick=()=>{if(confirm('Clear everything on this page?')){wipeState();location.reload()}};

/* ---------- state ---------- */
const fresh=()=>({stage:0,
  cards:{flip:[...Array(N)].map(()=>false),order:shuffle([...Array(N).keys()])},
  found:[],
  ccq:{queue:shuffle(DATA.ccq.map((_,k)=>k)),right:[],cur:null},
  fork:{sel:{},solved:[],border:{}},
  build:{sel:{},solved:[],tiles:{}},
  up:{val:{},state:{},order:shuffle(DATA.upgrade.map((_,k)=>k))},
  tr:{val:{},state:{}},
  use:{order:shuffle(DATA.use.map((_,k)=>k)),txt:{},done:[],cur:0},
  lock:{round:0,order:shuffle(DATA.lock.map((_,k)=>k)),val:{},state:{}},
  celebrated:[]});
let S=loadState()||fresh();
S.celebrated=S.celebrated||[];
S.lock.round=0;