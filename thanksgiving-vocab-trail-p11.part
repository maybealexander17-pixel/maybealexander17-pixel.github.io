const SFX={ctx:null,master:null,mute:false,log:[],init(){if(this.ctx)return true;try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return false;this.ctx=new AC();const c=this.ctx.createDynamicsCompressor();this.master=this.ctx.createGain();this.master.gain.value=.55;this.master.connect(c);c.connect(this.ctx.destination);return true}catch(e){return false}},tone(f,t,d=.12,type='sine',v=.08,to=null){if(!this.ctx)return;const o=this.ctx.createOscillator(),g=this.ctx.createGain(),n=this.ctx.currentTime+t;o.type=type;o.frequency.setValueAtTime(f,n);if(to)o.frequency.exponentialRampToValueAtTime(to,n+d);g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(v,n+.012);g.gain.exponentialRampToValueAtTime(.0001,n+d);o.connect(g);g.connect(this.master);o.start(n);o.stop(n+d+.02)},play(name){this.log.push(name);if(this.mute||!this.init())return;try{if(this.ctx.state==='suspended')this.ctx.resume();if(name==='right'){this.tone(520,0,.09,'sine',.08,680);this.tone(760,.07,.12,'sine',.07)}else if(name==='wrong')this.tone(170,0,.15,'triangle',.08,120);else if(name==='flip')this.tone(380,0,.07,'sine',.035,480);else if(name==='tick')this.tone(600,0,.035,'sine',.025);else if(name==='stage')[440,554,659].forEach((f,i)=>this.tone(f,i*.09,.18,'sine',.065));else if(name==='win')[392,494,587,784].forEach((f,i)=>this.tone(f,i*.11,.3,'triangle',.07))}catch(e){}}};
try{SFX.mute=localStorage.getItem('vp:sound')==='mute'||localStorage.getItem('vp:sound')==='off'}catch(e){}
function drawMute(){const b=$('#mute');b.textContent=SFX.mute?'Muted':'Sound on';b.setAttribute('aria-label',SFX.mute?'Sound muted. Tap to turn sound on.':'Sound on. Tap to mute.');b.setAttribute('aria-pressed',String(SFX.mute))}
$('#mute').onclick=()=>{SFX.mute=!SFX.mute;try{localStorage.setItem('vp:sound',SFX.mute?'mute':'on')}catch(e){}drawMute();if(!SFX.mute)SFX.play('flip')};drawMute();
function toast(msg,withReset=false){const t=$('#toast');t.innerHTML=`<span>${esc(msg)}</span>${withReset?'<button type="button" id="toastReset">Start over</button>':''}`;t.hidden=false;if(withReset)$('#toastReset').onclick=reset;clearTimeout(toast.t);toast.t=setTimeout(()=>t.hidden=true,withReset?7000:2600)}
function celebrate(key,big=false){if(S.celebrated.includes(key))return;S.celebrated.push(key);save();SFX.play(big?'win':'stage');if(FAST||RM)return;const r=$('#rain');r.innerHTML='';for(let i=0;i<(big?44:24);i++){const p=document.createElement('i');p.style.left=Math.random()*100+'%';p.style.animationDelay=Math.random()*.45+'s';r.appendChild(p)}setTimeout(()=>r.innerHTML='',2100)}
function reset(){if(!confirm('Start over and erase every answer on this device?'))return;resetting=true;clearTimeout(saveT);try{localStorage.removeItem(SAVE_KEY)}catch(e){}S=fresh();resetting=false;save();go(0);toast('A clean trail. Start again when you are ready.')}
$('#reset').onclick=reset;
const STAGES=['Cards','Notice','Meaning','Partners','Upgrade','Translate','Use it','Lock it in'];
const main=$('#main');let R=[];
$('#nav').innerHTML=STAGES.map((t,i)=>`<button type="button" data-i="${i}">${i+1}. ${t}<span class="badge tb">–</span></button>`).join('');$$('#nav button').forEach(b=>b.onclick=()=>go(+b.dataset.i));
function remaining(k){if(k===0)return S.cards.flip.filter(x=>!x).length;if(k===1)return 20-S.found.length;if(k===2)return S.ccq.queue.length;if(k===3)return DATA.forks.length-S.fork.solved.length+DATA.build.length-S.build.solved.length;if(k===4)return DATA.upgrade.length-Object.values(S.up.state).filter(v=>v==='ok').length;if(k===5)return DATA.translate.length-Object.values(S.tr.state).filter(v=>v==='ok').length;if(k===6)return DATA.use.length-S.use.done.length;if(k===7)return DATA.lock.filter((_,i)=>S.lock.state[i]!=='ok').length;return 0}
function drawBadges(){$$('#nav button').forEach((b,k)=>{const r=remaining(k);$('.tb',b).textContent=r;b.classList.toggle('done',r===0)});const total=[...Array(8).keys()].reduce((a,k)=>a+remaining(k),0);$('#total').textContent=total;if(total===0)celebrate('all',true)}