<script>

/* ================= ENGINE ================= */
const DATA=JSON.parse(document.getElementById('data').textContent);
const I=DATA.items, N=I.length;
const FAST=/[?&]fast=1/.test(location.search);
if(FAST)document.documentElement.classList.add('fast');
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
function norm(s){return String(s).toLowerCase().replace(/[‘’]/g,"'").replace(/[“”]/g,'"').replace(/[^a-z0-9\s'-]/g,' ').replace(/\s+/g,' ').trim()}
function shuffle(a){a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function hash(s){let h=0;for(let i=0;i<s.length;i++){h=(h*31+s.charCodeAt(i))|0}return(h>>>0).toString(36)}
const SAVE_KEY='vp:survival-stories-lexical-trail:'+hash(JSON.stringify([DATA.notice,DATA.ccq,DATA.forks,DATA.build,DATA.upgrade,DATA.translate,DATA.use,DATA.lock]));