R[4]=()=>{main.innerHTML=`<section class="stage">${head(5,'Say it better','Twelve flat, wordy sentences. Rewrite each with the target phrase. Type it yourself, no word bank. Small spelling slips are fine; the target chunk is not.')}<div id="q"></div></section>`;const show=()=>{const k=S.up.order.find(k=>S.up.state[k]!=='ok');if(k===undefined){$('#q').innerHTML='<div class="card"><span class="okc">All twelve upgraded.</span></div>';celebrate('upgrade');drawBadges();return}const q=DATA.upgrade[k],v=S.up.val[k]||'';$('#q').innerHTML=`<div class="card"><div class="flat">${esc(q.flat).replace(/\[\[(.+?)\]\]/g,'<span class="u">$1</span>')}</div><input class="in" id="ans" autocomplete="off" placeholder="Type the whole upgraded sentence…" value="${esc(v)}" ${S.up.state[k]==='ok'?'readonly':''}><div class="fb" id="fb"></div><div class="row"><button type="button" class="btn sm" id="check">Check</button><button type="button" class="btn ghost sm" id="model">Show a model</button><button type="button" class="btn ghost sm" id="skip">Skip for now</button></div></div>`;const a=$('#ans');a.oninput=()=>{S.up.val[k]=a.value;save()};a.onkeydown=e=>{if(e.key==='Enter')$('#check').click()};$('#check').onclick=()=>{S.up.val[k]=a.value;const n=norm(a.value),fb=$('#fb');fb.classList.add('show');if(new RegExp(q.re,'i').test(n)){S.up.state[k]='ok';SFX.play('right');save();drawBadges();fb.innerHTML=`<span class="okc">That works.</span> ${itemLine(q.i)}<p><button type="button" class="btn sm" id="nx">Next</button></p>`;$('#nx').onclick=show}else{S.up.state[k]='no';SFX.play('wrong');save();fb.innerHTML=q.no&&new RegExp(q.no,'i').test(n)?'Almost, but the particle is wrong. Check the exact phrase on your cards.':`Not yet. You need <b>${esc(I[q.i].c)}</b>, not just a synonym. Read the flat phrase again.`}};$('#model').onclick=()=>{const fb=$('#fb');fb.classList.add('show');fb.innerHTML=`<b>One possible version:</b> ${esc(q.model)}<br><span class="mute small">Close the model and type your own version to clear the item.</span>`};$('#skip').onclick=()=>{S.up.order.push(S.up.order.shift());save();show()}};show()};

/* 6 · Russian to English */
R[5]=()=>{main.innerHTML=`<section class="stage">${head(6,'From Russian, precisely','Translate into natural English using the target chunk. The Russian is chosen to trap direct translation, so watch particles, possessives, and fixed word order.')}<div id="q"></div></section>`;const show=()=>{const k=S.tr.order.find(k=>S.tr.state[k]!=='ok');if(k===undefined){$('#q').innerHTML='<div class="card"><span class="okc">All twelve translated.</span></div>';celebrate('translate');drawBadges();return}const q=DATA.translate[k];$('#q').innerHTML=`<div class="card"><div class="ru">${esc(q.ru)}</div><input class="in" id="ans" autocomplete="off" placeholder="Your English translation…" value="${esc(S.tr.val[k]||'')}"><div class="fb" id="fb"></div><div class="row"><button type="button" class="btn sm" id="check">Check</button><button type="button" class="btn ghost sm" id="model">Show a model</button><button type="button" class="btn ghost sm" id="skip">Skip for now</button></div></div>`;const a=$('#ans');a.oninput=()=>{S.tr.val[k]=a.value;save()};a.onkeydown=e=>{if(e.key==='Enter')$('#check').click()};$('#check').onclick=()=>{S.tr.val[k]=a.value;const fb=$('#fb');fb.classList.add('show');if(new RegExp(q.re,'i').test(norm(a.value))){S.tr.state[k]='ok';SFX.play('right');save();drawBadges();fb.innerHTML=`<span class="okc">Yes.</span> ${itemLine(q.i)}<div class="note">${esc(q.note)}</div><p><button type="button" class="btn sm" id="nx">Next</button></p>`;$('#nx').onclick=show}else{S.tr.state[k]='no';SFX.play('wrong');save();fb.innerHTML=`Not the target chunk yet. Aim for <b>${esc(I[q.i].c)}</b>.<div class="note">${esc(q.note)}</div>`}};$('#model').onclick=()=>{const fb=$('#fb');fb.classList.add('show');fb.innerHTML=`<b>Model:</b> ${esc(q.en)}<br><span class="mute small">Close the model and type it yourself to clear the item.</span>`};$('#skip').onclick=()=>{S.tr.order.push(S.tr.order.shift());save();show()};};show()};

/* 7 · Speak, then write with live detection */