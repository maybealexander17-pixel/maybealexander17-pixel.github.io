 {i:14,q:'The chair sends a gatecrasher packing. What happens?',a:'The gatecrasher is made to leave.',b:'The gatecrasher is invited to speak.',right:0},
 {i:15,q:'What must organizers do when they contend with a shortage?',a:'Deal with that difficulty.',b:'Pretend the shortage is an advantage.',right:0},
 {i:16,q:'Two committees fight it out over the budget. When does the dispute end?',a:'After they argue or compete until it is settled.',b:'Before either side expresses an opinion.',right:0},
 {i:17,q:'Which strategy is divide and conquer?',a:'Turn members of a group against one another to weaken it.',b:'Bring every member together around a shared goal.',right:0},
 {i:18,q:'What does a committee gain with some breathing space?',a:'A temporary pause or extra room to think.',b:'A larger permanent office.',right:0},
 {i:19,q:'Who is at the forefront of a development?',a:'The people in a leading, visible position.',b:'The people who hear about it last.',right:0}
],
forks:[
 {i:0,stem:'By seven, the street market ___.',opts:['was in full swing','was at its height','was in high gear','was on the table'],odd:3,why:'In full swing, at its height, and in high gear describe peak activity. On the table means up for discussion.'},
 {i:1,stem:'They passed the story ___.',opts:['off as fact','off as history','off as a recent discovery','down the generations'],odd:3,why:'The target is pass something off as something, to misrepresent it. Pass down means hand it to the next generation.'},
 {i:2,stem:'To cap the evening ___.',opts:['off with dessert','off with a song','off with fireworks','out with a bang'],odd:3,why:'Cap an event off with its finishing touch. Out with a bang belongs to go out with a bang.'},
 {i:3,stem:'The neighbors pulled the family ___.',opts:['through the crisis','through the winter','through a difficult year','apart'],odd:3,why:'Pull somebody through means help them survive a hard period. Pull apart means break up, a family included.'},
 {i:4,stem:'After the disruption, we let events ___.',opts:['take their natural course','run their natural course','develop naturally','take over'],odd:3,why:'Take their course, run their course, and develop naturally mean proceed without interference. Take over means seize control.'},
 {i:5,stem:'It all began as ___.',opts:['the germ of an idea','a rough sketch of a plan','the barest outline of a scheme','the finished product'],odd:3,why:'The germ of an idea, a rough sketch, and the barest outline describe something just beginning. The finished product is not a beginning.'},
 {i:6,stem:'The small market soon blossomed ___.',opts:['into a tradition','into a movement','into an annual event','from a modest start'],odd:3,why:'Blossom into names what something becomes. Blossom from names where it started.'},
 {i:7,stem:'a throwaway ___',opts:['gesture','remark','comment','cup'],odd:3,why:'A throwaway gesture, remark, or comment is delivered casually, without real commitment. A throwaway cup is simply disposable.'},
 {i:8,stem:'___ over the details',opts:['fret','agonize','brood','dwell'],odd:3,why:'Fret over, agonize over, and brood over mean to worry. Dwell takes on, not over.'},
 {i:10,stem:'The new dates ___ neatly with the harvest season.',opts:['fit','align','square','clash'],odd:3,why:'Fit, align, and square with mean match. Clash with means the opposite.'}
],
build:[
 {i:9,tiles:['blessed','with','fertile','soil','by'],ans:[0,1,2,3],cue:'Our region is ______.'},
 {i:13,tiles:['averted','their','eyes','from','at'],ans:[0,1,2,3],cue:'Many readers ______ the upsetting details.'},
 {i:14,tiles:['sent','the','gatecrasher','packing','packed'],ans:[0,1,2,3],cue:'The council ______ after the interruption.'},
 {i:15,tiles:['contend','with','at'],ans:[0,1],cue:'We had to ______ a shortage of volunteers.'},
 {i:16,tiles:['fought','it','out','themselves'],ans:[0,1,2],cue:'The two committees ______ over the budget.'},
 {i:17,tiles:['divide','and','conquer','conqueror'],ans:[0,1,2],cue:'The manager used a ______ strategy.'}
],
