function detailFor(id){const i=({full:0,pass:1,cap:2,pull:3,natural:4,germ:5,blossom:6,throwaway:7,fret:8,blessed:9,align:10,divert:11,downplay:12,avert:13,send:14,contend:15,fight:16,divide:17,breathing:18,forefront:19})[id];return`<div class="hand" style="font-size:1.4rem">${esc(I[i].c)}</div><div style="color:var(--blue);font-weight:700">${esc(I[i].ru)}</div><div style="margin-top:4px">${esc(I[i].m[0].toUpperCase()+I[i].m.slice(1))}.</div><div class="mute small" style="margin-top:4px">${esc(I[i].n)}</div>`}

/* 3 · Either/or meaning, wrong answers return */
R[2]=()=>{main.innerHTML=`<section class="stage">${head(3,'Do you really get it?','Quick either/or questions. A wrong answer sends the phrase to the back of the queue, so it comes back.')}<div class="prog"><i id="pg"></i></div><div id="q"></div></section>`;const show=()=>{$('#pg').style.width=S.ccq.right.length/20*100+'%';if(!S.ccq.queue.length){$('#q').innerHTML=`<div class="card"><span class="okc">All twenty cleared.</span> <span class="mute">Next: the words each phrase likes to go with.</span></div>`;celebrate('meaning');drawBadges();return}const qi=S.ccq.queue[0],q=DATA.ccq[qi],ord=S.ccq.optOrder[qi]||(S.ccq.optOrder[qi]=shuffle([0,1]));$('#q').innerHTML=`<div class="card"><div style="font:1.08rem/1.6 var(--serif);margin-bottom:10px">${esc(q.q)}</div><div class="opts row" style="flex-direction:column;align-items:stretch">${ord.map(k=>`<button type="button" class="btn ghost" data-k="${k}" style="text-align:left">${esc(k===0?q.a:q.b)}</button>`).join('')}</div><div class="fb" id="fb"></div></div>`;const bs=$$('#q .opts button');bs.forEach(b=>b.onclick=()=>{const ok=+b.dataset.k===q.right;bs.forEach(x=>x.disabled=true);bs.find(x=>+x.dataset.k===q.right).style.background='var(--good-bg)';if(!ok)b.style.background='var(--bad-bg)';S.ccq.queue.shift();if(ok){if(!S.ccq.right.includes(qi))S.ccq.right.push(qi)}else S.ccq.queue.push(qi);SFX.play(ok?'right':'wrong');save();drawBadges();$('#fb').className='fb show';$('#fb').innerHTML=`${itemLine(q.i)} · ${esc(I[q.i].m)}.<div class="mute small">${esc(I[q.i].n)}</div><p><button type="button" class="btn sm" id="nx">Next</button></p>`;$('#nx').onclick=show})};show()};

/* 4 · Collocation forks + phrase building, all options shuffled */
R[3]=()=>{main.innerHTML=`<section class="stage">${head(4,'Partners','Part A: exactly three of the four phrases are good English. Tick three, leave the odd one out. Part B: build the phrase, one tile at a time.')}<div class="twocol"><div><h3 style="font:600 1.35rem var(--disp)">A · Three of four</h3><div id="forks"></div></div><div><h3 style="font:600 1.35rem var(--disp)">B · Build the phrase</h3><div id="builds"></div></div></div></section>`;
 const fk=$('#forks');DATA.forks.forEach((f,k)=>{const sel=S.fork.sel[k]||[],solved=S.fork.solved.includes(k),ord=S.fork.order[k];fk.insertAdjacentHTML('beforeend',`<div class="card"><div class="mono" style="margin-bottom:8px">${esc(f.stem)}</div>${ord.map(oi=>{const on=sel.includes(oi);let cls=on?'on':'';if(solved)cls=oi===f.odd?'bad':'ok';return`<div class="opt ${cls}" data-f="${k}" data-o="${oi}" role="checkbox" aria-checked="${on}" tabindex="${solved?-1:0}">${esc(f.opts[oi])}</div>`}).join('')}<div class="row"><button type="button" class="btn sm" data-check="${k}" ${solved?'disabled':''}>Check</button><span class="fb" id="ffb${k}">${solved?'✓ '+esc(f.why):''}</span></div></div>`)});
 $$('.opt',fk).forEach(el=>{const fn=()=>{const k=+el.dataset.f,o=+el.dataset.o;if(S.fork.solved.includes(k))return;const a=S.fork.sel[k]||(S.fork.sel[k]=[]),p=a.indexOf(o);if(p<0)a.push(o);else a.splice(p,1);el.classList.toggle('on',p<0);el.setAttribute('aria-checked',String(p<0));SFX.play('tick');save()};bindActivate(el,fn)});
 $$('[data-check]',fk).forEach(b=>b.onclick=()=>{const k=+b.dataset.check,f=DATA.forks[k],a=S.fork.sel[k]||[],ok=a.length===3&&!a.includes(f.odd);const fb=$('#ffb'+k);fb.classList.add('show');if(ok){S.fork.solved.push(k);SFX.play('right');save();R[3]();drawBadges()}else{SFX.play('wrong');fb.textContent=a.length!==3?'Tick exactly three phrases.':'One of your three is the odd one out. Have another look.';save()}});