.sectionlabel{font:600 1.35rem/1.2 var(--hand);color:var(--rust-dark);margin:22px 0 4px}
.rain{position:fixed;inset:0;pointer-events:none;z-index:50;overflow:hidden}.rain i{position:absolute;top:-24px;width:10px;height:18px;background:var(--rust);animation:fall 1.4s ease-in both}.rain i:nth-child(3n){background:var(--gold)}.rain i:nth-child(3n+1){background:var(--blue)}@keyframes fall{to{transform:translateY(110vh) rotate(300deg);opacity:.1}}
.toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:60;background:var(--ink);color:var(--paper);padding:12px 16px;max-width:calc(100% - 32px);display:flex;gap:14px;align-items:center}.toast button{border:1px solid var(--gold);background:transparent;color:var(--paper);min-height:40px;padding:6px 10px}
footer{padding:26px 0 44px;color:var(--muted);font-size:.82rem;display:flex;justify-content:space-between;gap:16px;align-items:center;border-top:1px solid var(--pale);margin-top:20px}.reset{border:0;background:transparent;color:var(--rust);text-decoration:underline;text-underline-offset:4px;min-height:44px;padding:8px 0}
/* Flip cards */
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}.fcard{position:relative;display:grid;width:100%;min-height:180px;border:1px solid var(--rust);border-radius:0;background:var(--paper);cursor:pointer;perspective:700px;text-align:left;padding:0;transform-style:preserve-3d;transition:transform .32s}
.fcard .face{grid-area:1/1;display:flex;flex-direction:column;gap:8px;width:100%;padding:16px;backface-visibility:hidden}.fcard .front .c{font:700 1.3rem/1.15 var(--display);color:var(--rust-dark)}.fcard .front .p{font:800 .62rem/1.2 var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--blue)}.fcard .front .hint{margin-top:auto;font:1rem var(--hand);color:var(--muted)}
.fcard .back{background:var(--soft);transform:rotateY(180deg)}.fcard .back .m{font-size:.9rem;line-height:1.4}.fcard .back .ru{color:var(--rust-dark);font-weight:800;font-size:.84rem}.fcard .back .col{font-size:.85rem}.fcard .back .nt{font:1rem/1.15 var(--hand);color:var(--muted)}.fcard.flip{transform:rotateY(180deg)}
/* Noticing article */
.notice{background:color-mix(in oklch,var(--paper) 92%,var(--pale));border-top:2px solid var(--rust);border-bottom:1px solid var(--rust);padding:22px clamp(14px,3vw,28px)}
.notice h3{font:700 clamp(1.5rem,4vw,2.2rem)/1.1 var(--display);margin:4px 0 14px}.notice p{font:400 1.06rem/1.75 var(--serif);margin:0;white-space:pre-line}
#art span.t{cursor:pointer;padding:0 1px;box-decoration-break:clone;-webkit-box-decoration-break:clone;transition:background .16s}#art span.t:hover{background:var(--pale)}#art span.t.f{background:linear-gradient(transparent 55%,color-mix(in oklch,var(--gold) 38%,transparent) 55%)}#art span.t.clue{box-shadow:inset 0 -2px var(--rust)}
.detail{min-height:64px}.prompts .chip{max-width:100%;text-align:left}.model{margin-top:12px}.lockcard{padding:12px 0;margin:8px 0}
.twocol{display:grid;grid-template-columns:1fr 1fr;gap:26px;align-items:start}.twocol h3{margin:8px 0 14px;color:var(--rust-dark)}
.twocol .card{padding:16px;background:color-mix(in oklch,var(--paper) 94%,transparent);border:1px solid var(--pale);border-top:2px solid var(--gold);margin:0 0 14px}
.opt{position:relative;padding:10px 10px 10px 34px;border-bottom:1px solid var(--pale);cursor:pointer;line-height:1.35;user-select:none}.opt:last-of-type{border-bottom:0}.opt:before{content:'';position:absolute;left:7px;top:12px;width:15px;height:15px;border:1px solid var(--blue);background:var(--paper)}.opt:hover{background:var(--soft)}.opt.on{background:color-mix(in oklch,var(--pale) 48%,transparent)}.opt.on:before{background:var(--blue);box-shadow:inset 0 0 0 3px var(--paper)}.opt.ok{color:var(--good);background:var(--good-bg)}.opt.ok:before{border-color:var(--good);background:var(--good)}.opt.bad{color:var(--bad);background:var(--bad-bg);text-decoration:line-through}.opt.bad:before{border-color:var(--bad);background:var(--bad)}