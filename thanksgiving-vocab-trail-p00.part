<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#9B4634">
<meta name="description" content="An eight-stage vocabulary trail for Philip Deloria's The Invention of Thanksgiving.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='8' fill='%23F8F3E8'/%3E%3Cpath d='M12 47h40M17 39l11-22 7 13 6-9 8 18' fill='none' stroke='%239B4634' stroke-width='3'/%3E%3C/svg%3E">
<title>The Invention of Thanksgiving · Vocabulary Trail</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Noto+Serif+Display:ital,wght@0,500;0,600;0,700;0,800;1,500&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<style>
:root{
  --paper:oklch(96.50% .0155 86.42);--rust:oklch(50.06% .1180 33.43);--rust-dark:oklch(40.51% .0960 32.01);
  --blue:oklch(51.52% .0360 227.91);--gold:oklch(64.03% .1007 77.65);--ink:oklch(26.80% .0024 247.91);
  --muted:oklch(47.14% .0083 88.70);--pale:oklch(89.99% .0260 84.59);--good:oklch(43.46% .0555 169.48);
  --good-bg:oklch(93.10% .0170 137.03);--bad:oklch(46.67% .1072 29.29);--bad-bg:oklch(91.63% .0250 49.73);
  --bg:var(--paper);--card:var(--paper);--text:var(--ink);--accent:var(--rust);--line:var(--pale);--soft:color-mix(in oklch,var(--paper) 82%,var(--pale));
  --display:'Noto Serif Display',Georgia,'Times New Roman',serif;--body:'Nunito Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;
  --serif:'Source Serif 4',Georgia,'Times New Roman',serif;--hand:'Caveat','Segoe Print',cursive;
}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:160px}
body{margin:0;min-height:100dvh;background:var(--bg);color:var(--text);font:16px/1.55 var(--body);overflow-x:hidden}
.photo-bg{position:fixed;inset:0;z-index:0;pointer-events:none;background:var(--photo-url) center/cover no-repeat;opacity:.085;filter:sepia(.18) saturate(.72)}
.wrap{width:min(1080px,calc(100% - 32px));margin:0 auto;position:relative;z-index:1;min-width:0}
button,input,textarea{font:inherit}button{color:inherit;cursor:pointer}button:disabled{cursor:not-allowed;opacity:.48}[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}::selection{background:var(--pale);color:var(--rust-dark)}
.skip{position:fixed;left:16px;top:12px;z-index:100;transform:translateY(-180%);opacity:0;pointer-events:none;background:var(--ink);color:var(--paper);padding:10px 16px}.skip:focus{transform:none;opacity:1;pointer-events:auto}
.kicker{font:800 .7rem/1.25 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--rust)}
.topline{border-bottom:1px solid var(--pale);min-height:50px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.club{font:800 .67rem/1.3 var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--rust-dark)}
.issue{font:600 .7rem/1.3 var(--body);letter-spacing:.08em;text-transform:uppercase;color:var(--blue)}
.hero{position:relative;text-align:center;padding:34px 0 28px;border-bottom:1px solid var(--pale)}
.hero .pretitle{font:500 italic clamp(1.35rem,4vw,2rem)/1.1 var(--display);margin:10px 0 0}
.hero h1{font:800 clamp(2.65rem,8vw,5.2rem)/.98 var(--display);letter-spacing:-.035em;color:var(--rust);margin:4px 0 14px}
.hero .sub{font:700 .74rem/1.4 var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--blue);margin:0}
.hero .by{font:400 .9rem/1.5 var(--serif);color:var(--muted);max-width:64ch;margin:10px auto 0}
.total{position:absolute;right:0;top:24px;display:flex;align-items:center;gap:8px;color:var(--rust)}
.total small{font:700 .64rem/1.2 var(--body);letter-spacing:.08em;text-transform:uppercase;max-width:64px;text-align:left}