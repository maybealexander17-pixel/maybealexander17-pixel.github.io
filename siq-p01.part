.navfoot{display:flex;justify-content:space-between;gap:10px;margin-top:18px}

/* generic bits */
.btn{border:2px solid var(--line);background:var(--yellow);border-radius:12px;padding:12px 20px;font:800 16px/1 var(--body);
  cursor:pointer;box-shadow:3px 3px 0 var(--line);transition:transform .12s,box-shadow .12s}
.btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--line)}
.btn.ghost{background:var(--card)}
.btn.sm{padding:9px 14px;font-size:14px;border-radius:10px;box-shadow:2px 2px 0 var(--line)}
.btn.teal{background:var(--teal);color:#fff}
.btn:disabled{opacity:.45;cursor:default}
.card{background:var(--card);border:2px solid var(--line);border-radius:16px;padding:16px;margin:12px 0;box-shadow:4px 4px 0 rgba(43,37,38,.16)}
.mute{color:var(--mute)}
.small{font-size:13.5px}
.hand{font-family:var(--hand)}
.fb{margin-top:10px;font-size:15px}
.fb.show{padding:10px 12px;border-radius:10px;background:var(--soft);border:1.5px dashed var(--mute)}
.okc{color:var(--ok);font-weight:800}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.prog{height:10px;background:var(--gray);border:2px solid var(--line);border-radius:99px;overflow:hidden;margin:4px 0 6px}
.prog i{display:block;height:100%;width:0;background:repeating-linear-gradient(-45deg,var(--yellow) 0 8px,var(--teal) 8px 16px);transition:width .35s}
.prog.green i{background:repeating-linear-gradient(-45deg,var(--ok-soft) 0 8px,var(--ok) 8px 16px)}
.chip{display:inline-block;border:2px solid var(--line);border-radius:999px;padding:6px 13px;background:var(--card);
  font:700 14.5px/1.2 var(--body);cursor:pointer;box-shadow:2px 2px 0 var(--line);transition:transform .12s}
.chip:active{transform:translate(1px,1px)}
.chip.sel{background:var(--yellow);transform:translate(2px,2px);box-shadow:0 0 0 var(--line)}
.chip.off{opacity:.4;text-decoration:line-through;pointer-events:none}
.chip.dash{border-style:dashed;background:var(--soft)}
input[type=text],textarea{width:100%;border:2px solid var(--line);border-radius:12px;padding:11px 13px;font:16px/1.4 var(--body);background:#fff}
textarea{min-height:110px;resize:vertical}
input:focus,textarea:focus,button:focus-visible{outline:3px solid var(--teal);outline-offset:1px}
mark{background:var(--hl);border-radius:4px;padding:0 3px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.shake{animation:shake .4s}
@keyframes shake{20%{transform:translateX(-6px)}40%{transform:translateX(5px)}60%{transform:translateX(-4px)}80%{transform:translateX(3px)}}
.pop{animation:pop .3s}
@keyframes pop{40%{transform:scale(1.06)}}
.stage{animation:rise .45s cubic-bezier(.2,.8,.2,1) both}
@keyframes rise{from{opacity:0;transform:translateY(16px)}}
.shead{display:flex;gap:14px;align-items:flex-start;margin:10px 0 4px}
.shead h2{font:700 clamp(24px,5vw,32px)/1.1 var(--display);margin:0}
.shead p{margin:5px 0 0;color:var(--mute);font-size:15px;max-width:560px}
.rain{position:fixed;inset:0;pointer-events:none;z-index:50;overflow:hidden}
.rain i{position:absolute;top:-30px;font-style:normal;animation:fall linear both}
@keyframes fall{to{transform:translateY(112vh) rotate(340deg)}}
.toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);background:var(--ink);color:#fff;border-radius:12px;
  padding:11px 16px;font:600 14px/1.35 var(--body);z-index:60;box-shadow:4px 4px 0 rgba(0,0,0,.25);max-width:92vw}
.toast button{background:var(--yellow);color:var(--ink);border:2px solid #fff;border-radius:8px;padding:4px 10px;font:800 13px var(--body);margin-left:10px;cursor:pointer}
.stamp{display:inline-block;font:700 13px var(--body);letter-spacing:.08em;text-transform:uppercase;color:var(--red);
  border:2.5px solid var(--red);border-radius:8px;padding:3px 9px;transform:rotate(-3deg)}

/* stage-specific */
.fcard{position:relative;display:block;width:100%;min-height:150px;border:2px solid var(--line);border-radius:16px;background:var(--card);
  box-shadow:4px 4px 0 rgba(43,37,38,.16);cursor:pointer;perspective:600px;text-align:left;padding:0;transform-style:preserve-3d;transition:transform .35s}
.fcard .face{display:flex;flex-direction:column;gap:6px;padding:14px 16px;backface-visibility:hidden}