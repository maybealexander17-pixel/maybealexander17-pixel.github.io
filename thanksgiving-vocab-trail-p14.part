 const bd=$('#builds');DATA.build.forEach((b,k)=>{const solved=S.build.solved.includes(k);if(!S.build.tiles[k]){let o=shuffle(b.tiles.map((_,j)=>j)),tries=0;while(o.slice(0,b.ans.length).join(',')===b.ans.join(',')&&tries++<20)o=shuffle(o);S.build.tiles[k]=o}const sel=S.build.sel[k]||[],ord=S.build.tiles[k];bd.insertAdjacentHTML('beforeend',`<div class="card"><div class="mono" style="margin-bottom:8px">${esc(b.cue)}</div><div class="tiles" id="out${k}">${sel.length?sel.map(j=>`<span class="tile" style="cursor:pointer" data-pick="${k}" data-j="${j}" role="button" tabindex="0">${esc(b.tiles[j])}</span>`).join(''):'<span class="mute small">Tap tiles below in the right order.</span>'}</div><div class="tiles">${ord.map(j=>`<span class="tile ${sel.includes(j)||solved?'used':''}" data-bank="${k}" data-j="${j}" role="button" tabindex="${sel.includes(j)||solved?-1:0}">${esc(b.tiles[j])}</span>`).join('')}</div><div class="row"><button type="button" class="btn sm" data-bcheck="${k}" ${solved?'disabled':''}>Check</button><button type="button" class="btn ghost sm" data-bclear="${k}" ${solved?'disabled':''}>Clear</button><span class="fb" id="bfb${k}">${solved?'✓ '+esc(b.ans.map(j=>b.tiles[j]).join(' ')):''}</span></div></div>`)});
 $$('[data-bank]',bd).forEach(el=>{const fn=()=>{const k=+el.dataset.bank,j=+el.dataset.j;if(S.build.solved.includes(k))return;const a=S.build.sel[k]||(S.build.sel[k]=[]);if(!a.includes(j)&&a.length<DATA.build[k].ans.length)a.push(j);SFX.play('tick');save();R[3]()};bindActivate(el,fn)});
 $$('[data-pick]',bd).forEach(el=>{const fn=()=>{const k=+el.dataset.pick,j=+el.dataset.j;if(S.build.solved.includes(k))return;S.build.sel[k]=(S.build.sel[k]||[]).filter(x=>x!==j);SFX.play('tick');save();R[3]()};bindActivate(el,fn)});
 $$('[data-bclear]',bd).forEach(el=>el.onclick=()=>{const k=+el.dataset.bclear;S.build.sel[k]=[];save();R[3]()});
 $$('[data-bcheck]',bd).forEach(el=>el.onclick=()=>{const k=+el.dataset.bcheck,b=DATA.build[k],a=S.build.sel[k]||[],ok=a.length===b.ans.length&&a.every((v,i)=>v===b.ans[i]);if(ok){if(!S.build.solved.includes(k))S.build.solved.push(k);SFX.play('right');save();R[3]();drawBadges()}else{SFX.play('wrong');const fb=$('#bfb'+k);fb.textContent=a.length<b.ans.length?'The phrase is not complete yet.':'Not quite. Check the fixed words and the word order.';fb.classList.add('show');save()}});
 save();drawBadges()};

/* 5 · Type the upgrade, no word bank */