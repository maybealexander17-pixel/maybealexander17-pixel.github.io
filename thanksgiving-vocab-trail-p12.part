function go(i){clearInterval(window._tm);S.stage=Math.max(0,Math.min(7,i));save();$$('#nav button').forEach((b,k)=>b.classList.toggle('on',k===S.stage));const on=$('#nav').children[S.stage];if(on)on.scrollIntoView({inline:'center',block:'nearest',behavior:FAST||RM?'instant':'smooth'});$('#prev').style.visibility=S.stage?'visible':'hidden';$('#next').style.visibility=S.stage<7?'visible':'hidden';R[S.stage]();drawBadges();requestAnimationFrame(()=>{const top=$('.navrail').getBoundingClientRect().top+scrollY;window.scrollTo({top:Math.max(0,top-1),behavior:FAST?'instant':'smooth'})})}
$('#prev').onclick=()=>go(S.stage-1);$('#next').onclick=()=>go(S.stage+1);
const head=(n,h,t)=>`<div class="shead"><span class="badge">${n}</span><div><h2 id="stageTitle" tabindex="-1">${h}</h2><p>${t}</p></div></div>`;
const itemLine=i=>`<b>${esc(I[i].c)}</b> <span style="color:var(--blue)">${esc(I[i].ru)}</span>`;
function bindActivate(el,fn){el.addEventListener('click',fn);el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();fn(e)}})}

/* 1 · Twenty flip cards */
R[0]=()=>{main.innerHTML=`<section class="stage">${head(1,'Meet the twenty','Flip each card. Read the meaning, the Russian gloss, and one partner it likes. Nothing is checked, just get acquainted.')}<div class="row"><span class="prog" style="flex:1"><i id="pg"></i></span><span class="kicker" id="cnt"></span></div><div id="grid"></div></section>`;const g=$('#grid');S.cards.order.forEach(i=>{const f=S.cards.flip[i];g.insertAdjacentHTML('beforeend',`<button type="button" class="fcard ${f?'flip':''}" data-i="${i}" aria-pressed="${f}"><span class="face front"><span class="c">${esc(I[i].c)}</span><span class="p">${esc(I[i].pos)}</span><span class="hint">tap to flip</span></span><span class="face back"><span class="m">${esc(I[i].m)}</span><span class="ru">${esc(I[i].ru)}</span><span class="col"><b>${esc(I[i].col)}</b></span><span class="nt">${esc(I[i].n)}</span></span></button>`)});const upd=()=>{const d=S.cards.flip.filter(Boolean).length;$('#pg').style.width=d/N*100+'%';$('#cnt').textContent=d+' / '+N};upd();$$('.fcard',g).forEach(b=>b.onclick=()=>{const i=+b.dataset.i;S.cards.flip[i]=!S.cards.flip[i];b.classList.toggle('flip',S.cards.flip[i]);b.setAttribute('aria-pressed',S.cards.flip[i]);SFX.play('flip');save();upd();drawBadges()})};

/* 2 · Notice all twenty in co-text */
R[1]=()=>{main.innerHTML=`<section class="stage">${head(2,'Find them in the wild','Read the piece once for the story. Then tap every phrase from our twenty hiding inside it. Tap the whole phrase, not one word.')}<article class="notice"><div class="kicker">A community story</div><h3>${DATA.notice.head}</h3><p id="art"></p></article><div class="detail card" id="det"><span class="mute">Tap a phrase to see what it means and how it behaves.</span></div><div class="row"><span class="kicker" id="cnt"></span><button type="button" class="btn ghost sm" id="rev" hidden>Show me what I missed</button></div></section>`;$('#art').innerHTML=esc(DATA.notice.text).replace(/\[\[(\w+)\|(.+?)\]\]/g,(m,id,t)=>`<span class="t ${S.found.includes(id)?'f':''} ${S.cluesShown&&!S.found.includes(id)?'clue':''}" data-id="${id}" role="button" tabindex="0">${esc(t)}</span>`);const cnt=()=>{$('#cnt').textContent=S.found.length+' / 20 found';$('#rev').hidden=!(S.found.length>=7||S.noticeMisses>=4)||S.found.length===20};$$('.t',$('#art')).forEach(s=>bindActivate(s,()=>{const id=s.dataset.id;if(!S.found.includes(id)){S.found.push(id);s.classList.add('f');s.classList.remove('clue');SFX.play('right');save();drawBadges()}$('#det').innerHTML=detailFor(id);cnt();if(S.found.length===20)celebrate('notice')}));$('#art').addEventListener('click',e=>{if(e.target.closest('.t'))return;S.noticeMisses++;SFX.play('wrong');save();cnt()});$('#rev').onclick=()=>{S.cluesShown=true;$$('.t',$('#art')).forEach(s=>{if(!S.found.includes(s.dataset.id))s.classList.add('clue')});save();cnt();toast('The missed phrases are underlined. Tap each one to log it.')};cnt()};