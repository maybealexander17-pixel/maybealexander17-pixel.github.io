R[7]=()=>{main.innerHTML=`<section class="stage">${head(8,'Lock it in','One last pass through all twenty, with no Russian and no options. Complete each clue from memory. This is the retrieval that makes the phrase stick.')}<div id="q"></div></section>`;const show=()=>{const k=S.lock.order.find(k=>S.lock.state[k]!=='ok');if(k===undefined){$('#q').innerHTML='<div class="card"><h3 style="font:600 1.6rem var(--disp);margin-bottom:6px">The trail is complete.</h3><p style="font:1.05rem/1.6 var(--serif)">You have met, noticed, checked, rebuilt, translated, used, and retrieved all twenty phrases. Come back tomorrow and run this stage once more.</p></div>';celebrate('lock');drawBadges();return}const q=DATA.lock[k];$('#q').innerHTML=`<div class="card"><div class="kicker">${Object.values(S.lock.state).filter(v=>v==='ok').length} / 20 retrieved</div><div class="mono" style="margin:10px 0">${esc(q.clue)}</div><input class="in" id="ans" autocomplete="off" placeholder="Type the missing phrase…" value="${esc(S.lock.val[k]||'')}"><div class="fb" id="fb"></div><div class="row"><button type="button" class="btn sm" id="check">Check</button><button type="button" class="btn ghost sm" id="hint">Show the answer</button><button type="button" class="btn ghost sm" id="skip">Skip for now</button></div></div>`;const a=$('#ans');a.oninput=()=>{S.lock.val[k]=a.value;save()};a.onkeydown=e=>{if(e.key==='Enter')$('#check').click()};$('#check').onclick=()=>{S.lock.val[k]=a.value;const fb=$('#fb');fb.classList.add('show');if(new RegExp('^'+q.re+'$','i').test(norm(a.value))){S.lock.state[k]='ok';SFX.play('right');save();drawBadges();fb.innerHTML=`<span class="okc">Retrieved.</span> ${itemLine(q.i)}<p><button type="button" class="btn sm" id="nx">Next</button></p>`;$('#nx').onclick=show}else{S.lock.state[k]='no';SFX.play('wrong');save();fb.innerHTML='Not quite. Use the definition and grammar in the clue, and retrieve the exact chunk.'}};$('#hint').onclick=()=>{const fb=$('#fb');fb.classList.add('show');fb.innerHTML=`<b>${esc(q.model)}</b><br><span class="mute small">Now close the answer and type it yourself.</span>`};$('#skip').onclick=()=>{S.lock.order.push(S.lock.order.shift());save();show()};a.focus({preventScroll:true})};show()};

noteStorage();if(FAST)document.documentElement.classList.add('fast');go(Math.min(7,S.stage||0));if(restored&&([...Array(8).keys()].some(k=>remaining(k)<[20,20,20,16,12,12,5,20][k])))setTimeout(()=>toast('Welcome back. Your answers are where you left them.',true),400);
</script>
</body>
</html>
