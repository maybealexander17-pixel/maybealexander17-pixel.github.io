        <button class="mobile-stop" data-stage="4" type="button"><span class="node">05</span><span class="mobile-name">The Long Way Back</span><span class="node-state">Open</span></button>
        <button class="mobile-stop" data-stage="5" type="button"><span class="node">06</span><span class="mobile-name">Fort Kiowa</span><span class="node-state">Open</span></button>
