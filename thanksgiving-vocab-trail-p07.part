 {i:2,flat:'We [[finished the evening with one final song]].',gap:'We ______.',re:'cap(ped)? .{0,45} off with',no:'cap(ped)? .{0,45} out with',model:'We capped the evening off with a song.'},
 {i:3,flat:'The volunteers [[helped the family survive the crisis]].',gap:'The volunteers ______.',re:'pull(ed)? .{0,45} through',no:'pull(ed)? .{0,45} over',model:'The volunteers pulled the family through the crisis.'},
 {i:4,flat:'We stopped intervening and let events [[develop until they reached their own conclusion]].',gap:'We stopped intervening and let events ______.',re:'take their natural course',no:'take its natural course',model:'We stopped intervening and let events take their natural course.'},
 {i:6,flat:'The small meal [[grew successfully into an annual tradition]].',gap:'The small meal ______.',re:'blossom(ed)? into',no:'blossom(ed)? over',model:'The small meal blossomed into an annual tradition.'},
 {i:7,flat:'The mayor waved toward the lot in [[a casual action made without much thought]].',gap:'The mayor waved toward the lot in ______.',re:'a throwaway gesture',no:'a throwaway guest',model:'The mayor waved toward the lot in a throwaway gesture.'},
 {i:8,flat:'Mara [[worried repeatedly about the seating plan]].',gap:'Mara ______ the seating plan.',re:'fret(ted|ting)? over',no:'fret(ted|ting)? on',model:'Mara fretted over the seating plan.'},
 {i:10,flat:'The schedule [[matched the bus service closely and conveniently]].',gap:'The schedule ______ the bus service.',re:'align(ed)? neatly with',no:'align(ed)? neatly over',model:'The schedule aligned neatly with the bus service.'},
 {i:11,flat:'The banners should not [[make visitors stop focusing on the growers]].',gap:'The banners should not ______ the growers.',re:'divert attention from',no:'divert attention of',model:'The banners should not divert attention from the growers.'},
 {i:12,flat:'The report [[made the problems seem less serious than they were]].',gap:'The report ______.',re:'downplay(ed|ing|s)? .{0,45}',no:'downplay(ed)?\\b$',model:'The report downplayed the problems.'},
 {i:18,flat:'We [[got a temporary pause and room to think]] thanks to the extra week.',gap:'We ______ thanks to the extra week.',re:'gain(ed)? some breathing space',no:'gain(ed)? some breathe space',model:'We gained some breathing space thanks to the extra week.'}
],
translate:[
 {i:5,ru:'Зачатком фестиваля стала записка на доске в библиотеке.',en:'The germ of the festival was a note on the library board.',note:'The germ of names the small origin. Keep of before the thing that develops.',re:'the germ of'},
 {i:7,ru:'Мэр сделал небрежный жест в сторону старой парковки.',en:'The mayor made a throwaway gesture toward the old parking lot.',note:'Throwaway describes something casual and not carefully considered.',re:'throwaway gesture'},
 {i:8,ru:'Она весь день беспокоилась из-за плана рассадки.',en:'She fretted over the seating plan all day.',note:'Use fret over before the object of worry. Do not translate из-за literally as from here.',re:'fret(ted)? over'},
 {i:9,ru:'Нашему городу повезло с долгим теплым летом.',en:'Our town is blessed with a long, warm summer.',note:'Be blessed with presents a quality or resource as a fortunate advantage.',re:'(is|was|were|be) blessed with'},
 {i:11,ru:'Яркие баннеры отвлекали внимание от местных фермеров.',en:'The bright banners diverted attention from the local growers.',note:'Keep attention before from, then name what receives less focus.',re:'divert(ed)? attention from'},
 {i:13,ru:'Многие читатели отвели взгляд от неудобных деталей.',en:'Many readers averted their eyes from the uncomfortable details.',note:'The possessive agrees with readers: their eyes. Keep from.',re:'avert(ed)? their eyes from'},
 {i:14,ru:'После третьего перебивания председатель выпроводил нарушителя.',en:'After the third interruption, the chair sent the disruptor packing.',note:'Send somebody packing is informal and abrupt. Use packing, not packed.',re:'sent .{0,45} packing|send .{0,45} packing'},