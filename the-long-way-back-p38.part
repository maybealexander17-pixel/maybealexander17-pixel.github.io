.checkpoint{position:absolute;transform:translate(-50%,-50%);background:transparent;border:0;padding:0;cursor:pointer;text-align:center;width:136px;z-index:3}
.checkpoint .node{width:39px;height:39px;border-radius:50%;display:grid;place-items:center;margin:0 auto 10px;background:#102635;border:1px solid #66808d;color:var(--ice);font:700 1.2rem/1 var(--display);transition:background .2s,border-color .2s,box-shadow .2s}
.checkpoint .node-name{font:700 1.02rem/1.05 var(--display);letter-spacing:.04em;text-transform:uppercase;text-shadow:0 2px 8px #071521}
.checkpoint .node-state{display:block;color:var(--muted);font-size:.65rem;letter-spacing:.09em;text-transform:uppercase;margin-top:5px}
.checkpoint:hover .node{border-color:var(--frost);background:var(--navy2)}
.checkpoint.current .node{border-color:var(--frost);box-shadow:0 0 0 5px rgba(153,215,220,.1)}
.checkpoint.complete .node{background:var(--amber);border-color:var(--amber2);color:var(--night);box-shadow:0 0 18px rgba(217,148,91,.25)}
.checkpoint.complete .node-state{color:var(--amber2)}
.map-mobile{display:none}
.route-foot{display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:.82rem;margin-top:14px}

/* story and tasks */
.journey{padding:12px 0 90px}
.stage{min-width:0;animation:arrive .45s ease both}
@keyframes arrive{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.stage-mast{display:grid;grid-template-columns:140px minmax(0,1fr);gap:34px;padding:38px 0 32px;border-top:1px solid var(--line)}
.stage-number{font:700 5.8rem/.8 var(--display);color:#35505e}
.stage-title{font-size:clamp(3rem,6vw,5.3rem);line-height:.9;margin:8px 0 16px}
.stage-deck{color:var(--muted);font-size:1.03rem;max-width:740px;margin:0}
.story-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(260px,.75fr);gap:54px;padding:34px 0 48px;border-top:1px solid var(--line)}
.story-copy{font-size:1.12rem;line-height:1.78;color:#d2e0e3}
.story-copy p{margin:0 0 1.1em}
.story-copy p:first-child:first-letter{font:700 3.5rem/.78 var(--display);float:left;color:var(--frost);padding:8px 9px 0 0}
.history-note{border-left:2px solid var(--amber);padding:3px 0 3px 20px;align-self:start}
.history-note h3{font:700 .75rem/1.2 var(--body);letter-spacing:.16em;text-transform:uppercase;color:var(--amber2);margin:0 0 12px}
.history-note p{font-size:.88rem;line-height:1.65;color:var(--muted);margin:0 0 12px}
.history-note p:last-child{margin-bottom:0}
.task-zone{background:var(--navy);border:1px solid var(--line);padding:clamp(22px,4vw,42px);box-shadow:var(--shadow)}
.task-head{display:flex;justify-content:space-between;align-items:start;gap:24px;padding-bottom:23px;border-bottom:1px solid var(--line);margin-bottom:28px}
.task-head h3{font:700 clamp(1.9rem,4vw,2.7rem)/1 var(--display);letter-spacing:.025em;text-transform:uppercase;margin:7px 0 9px}
.task-head p{margin:0;color:var(--muted);max-width:680px;font-size:.94rem}
.task-count{font:700 2rem/1 var(--display);color:var(--blue);white-space:nowrap}
.subtask{padding:28px 0;border-top:1px solid var(--line)}
.subtask:first-child{border-top:0;padding-top:0}
.subtask h4{font:700 1.4rem/1.1 var(--display);text-transform:uppercase;letter-spacing:.035em;margin:0 0 8px}
.subtask>p{color:var(--muted);margin:0 0 20px;font-size:.92rem}
.task-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:24px}
.task-feedback{margin-top:17px;padding:12px 15px;border-left:2px solid var(--blue);background:rgba(123,159,177,.07);font-size:.9rem;color:#c2d4da}
.task-feedback.good{border-color:var(--good)}
.task-feedback.bad{border-color:var(--bad)}
.inline-status{font-size:.84rem;color:var(--muted)}
.stage-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:24px}
.completion-note{font-size:.9rem;color:var(--muted)}
.completion-note.done{color:var(--good)}

/* flip cards */
.flash-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.flip-card{perspective:900px;min-height:250px;border:0;padding:0;background:transparent;cursor:pointer;text-align:left;min-width:0}