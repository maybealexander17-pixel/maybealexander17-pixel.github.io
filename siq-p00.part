<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>We're Stuck in Questions — Vocabulary Trail</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;0,900;1,500&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Patrick+Hand&display=swap" rel="stylesheet">
<style>
/* =========================================================
   LEXICAL TRAIL · skin: FRONT PAGE (cream newsprint, ink
   outlines, highlighter yellow, editor red, teal accents)
   ========================================================= */
:root{
  --bg:#F7F1E3; --bg2:#EFE7D2; --card:#FFFFFF; --ink:#221F1A; --mute:#6E6759; --line:#2B2526;
  --soft:#FBF7EC; --red:#C0392B; --red-d:#96281B; --yellow:#FFE95C; --teal:#0E7C7B;
  --gray:#ECE7DA; --ok:#2F8A3A; --ok-soft:#E3F4DE; --bad:#C23B2E; --bad-soft:#FBE4E1;
  --hl:#FFF0A3;
  --display:'Playfair Display',Georgia,'Times New Roman',serif;
  --body:'Nunito Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
  --hand:'Patrick Hand','Comic Sans MS','Segoe Print',cursive;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 var(--body);overflow-x:hidden}
button{font-family:inherit}
[hidden]{display:none!important}
.wrap{max-width:900px;margin:0 auto;padding:10px 14px 60px;position:relative;z-index:1}

/* drifting decorative badges */
.drift{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.drift span{position:absolute;width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:var(--red);color:#fff;
  border:2.5px solid var(--line);font:20px/1 var(--hand);border-radius:52% 48% 50% 50%/48% 52% 49% 51%;opacity:.18;animation:float 15s ease-in-out infinite alternate}
.drift span.alt{background:var(--yellow);color:var(--ink)}
@keyframes float{to{transform:translate(16px,-28px) rotate(13deg)}}

/* header */
.hero{position:relative;text-align:left;padding:24px 4px 10px}
.hero h1{font:700 clamp(34px,8vw,58px)/1 var(--display);margin:0;letter-spacing:-.01em}
.hero h1 span{display:block}
.hero h1 span:nth-child(2){padding-left:.6em}
.hero h1 span:nth-child(3){padding-left:1.2em}
.hero .sub{display:inline-block;margin:14px 0 0;background:var(--yellow);border:2px solid var(--line);border-radius:999px;padding:7px 18px;font:400 18px/1.2 var(--hand)}
.hero .by{margin:10px 0 0;color:var(--mute);font-size:14.5px;max-width:520px}
.total{position:absolute;right:6px;top:20px;display:flex;flex-direction:column;align-items:center;gap:4px}
.total .tb{width:74px;height:74px;font-size:30px}
.total small{font:15px var(--hand);color:var(--red-d);text-align:center;max-width:110px;line-height:1.1}
.badge{display:inline-flex;align-items:center;justify-content:center;background:var(--red);color:#fff;border:2.5px solid var(--line);
  font:700 15px/1 var(--body);border-radius:50%;min-width:34px;height:34px;padding:0 4px;box-shadow:2px 2px 0 var(--line)}
.tb{width:34px;height:34px}

/* stage rail */
.navrail{position:sticky;top:0;z-index:5;background:linear-gradient(var(--bg) 78%,transparent);padding:8px 0 14px}
#nav{display:flex;gap:8px;overflow-x:auto;overflow-y:hidden;padding:18px 2px 8px;scrollbar-width:thin}
#nav button{position:relative;flex:0 0 auto;border:2px solid var(--line);background:var(--card);border-radius:999px;
  padding:8px 14px;font:700 14.5px/1 var(--body);cursor:pointer;box-shadow:2px 2px 0 var(--line)}
#nav button.on{background:var(--ink);color:#fff}
#nav button.done{background:var(--ok-soft)}
#nav button .tb{position:absolute;top:-15px;right:-11px;width:30px;height:30px;font-size:12.5px;line-height:26px;min-width:30px;border-width:2px;padding:0;box-shadow:1.5px 1.5px 0 var(--line)}
#nav button.on .tb{box-shadow:1.5px 1.5px 0 rgba(0,0,0,.4)}
.bar{display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:2px solid var(--line);padding-top:10px}