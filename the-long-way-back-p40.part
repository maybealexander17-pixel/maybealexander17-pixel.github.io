.field-label{display:block;font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 0 7px}
textarea{width:100%;resize:vertical;min-height:96px;background:#071a26;color:var(--ice);border:1px solid #38535f;border-radius:0;padding:13px 14px;line-height:1.55}
textarea::placeholder{color:#69838f}
textarea:focus{border-color:var(--frost)}
.model-box{margin-top:15px;padding:16px;background:#d5e5e5;color:#15303b;font-size:.91rem;line-height:1.6}
.model-box strong{font-weight:600}
.model-box .model-label{display:block;font-size:.67rem;letter-spacing:.14em;text-transform:uppercase;color:#516b70;margin-bottom:6px}
.self-check{display:flex;align-items:start;gap:10px;margin-top:13px;font-size:.85rem;color:var(--muted);cursor:pointer}
.self-check input{accent-color:var(--amber);width:17px;height:17px;margin-top:3px;flex:none}
.model-box .self-check{color:#29464e}

/* sequence */
.sequence{list-style:none;padding:0;margin:0;display:grid;gap:8px;counter-reset:route}
.sequence li{display:grid;grid-template-columns:34px minmax(0,1fr) auto;align-items:center;gap:12px;border:1px solid var(--line);background:#0b202e;padding:12px 12px 12px 15px;counter-increment:route}
.sequence li:before{content:counter(route,decimal-leading-zero);font:700 1.25rem/1 var(--display);color:var(--blue)}
.sequence li.misplaced{border-color:var(--bad)}
.sequence-text{font-size:.91rem;line-height:1.5}
.move-buttons{display:flex;gap:5px}
.move-btn{width:35px;height:35px;background:#132d3a;border:1px solid #3b5661;cursor:pointer;color:var(--frost);display:grid;place-items:center}
.move-btn:hover:not(:disabled){border-color:var(--frost)}
.move-btn:disabled{opacity:.25;cursor:default}
.word-meter{display:flex;gap:18px;flex-wrap:wrap;margin:10px 0 0;color:var(--muted);font-size:.8rem}
.word-meter span.on{color:var(--good)}
.target-detect{margin-top:12px;font-size:.8rem;color:var(--muted)}
.target-detect strong{color:var(--frost);font-weight:600}

/* final discussion */
.discussion-intro{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(250px,.8fr);gap:35px;padding-bottom:28px}
.discussion-intro h4{font-size:2.2rem;margin:0 0 12px}
.discussion-intro p{margin:0;color:var(--muted)}
.quote{border-left:1px solid var(--rose);padding-left:18px;color:#c8d5d8;font-size:.94rem}
.quote cite{display:block;color:var(--muted);font-size:.75rem;font-style:normal;margin-top:8px;letter-spacing:.06em;text-transform:uppercase}
.prompt-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.prompt-card{border:1px solid var(--line);background:#0b202e;padding:21px;min-width:0;display:flex;flex-direction:column}
.prompt-card.prepared{border-color:#5b857f}
.prompt-top{display:flex;justify-content:space-between;gap:14px;color:var(--blue);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase}
.prompt-card h4{font:700 1.55rem/1.05 var(--display);text-transform:uppercase;letter-spacing:.025em;margin:18px 0 12px}
.prompt-card p{font-size:.92rem;line-height:1.55;color:#c3d4d8;margin:0 0 15px}
.prompt-language{font-size:.77rem;color:var(--muted);margin:auto 0 16px;padding-top:8px;border-top:1px solid var(--line)}
.prompt-language strong{color:var(--frost);font-weight:600}
.prompt-actions{display:flex;gap:9px;flex-wrap:wrap}
.angles{margin-top:14px;padding-top:13px;border-top:1px solid var(--line);font-size:.84rem;color:var(--muted)}
.angles ul{padding-left:18px;margin:7px 0 0}
.final-checks{display:grid;gap:8px;margin:18px 0}
.completion-banner{margin-top:26px;padding:30px;border:1px solid var(--amber);background:linear-gradient(120deg,rgba(217,148,91,.12),rgba(153,215,220,.04));text-align:center}
.completion-banner h3{font:700 clamp(2.7rem,6vw,4.7rem)/.95 var(--display);text-transform:uppercase;margin:8px 0 13px;color:var(--amber2)}
.completion-banner p{max-width:620px;margin:0 auto 18px;color:#c7d6d9}

/* sources and footer */
.sources{padding:55px 0 70px;border-top:1px solid var(--line);background:#081925}
.sources-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:60px}
.sources h2{font-size:2.4rem;line-height:1;margin:8px 0 18px}
.sources p{color:var(--muted);font-size:.9rem}