    const solved=S.fork.solved.includes(fk);
    fw.insertAdjacentHTML('beforeend',
     `<div class="card" style="${solved?'background:var(--ok-soft)':''}" data-fk="${fk}">
        <div class="hand" style="font-size:20px;margin-bottom:8px">${esc(f.stem)}</div>
        <div class="row" style="gap:6px">${f.opts.map((o,ok)=>`<button type="button" class="chip${(S.fork.sel[fk]||[]).includes(ok)?' sel':''}" data-ok="${ok}" ${solved?'disabled':''}>${esc(o)}</button>`).join('')}</div>
        <div class="fb" id="ff${fk}"></div></div>`);
  });
  fw.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{
    const fk=+c.closest('.card').dataset.fk,ok=+c.dataset.ok;
    S.fork.sel[fk]=S.fork.sel[fk]||[];
    const j=S.fork.sel[fk].indexOf(ok);
    if(j>=0)S.fork.sel[fk].splice(j,1);else{S.fork.sel[fk].push(ok);if(S.fork.sel[fk].length>3)S.fork.sel[fk].shift()}
    const card=c.closest('.card');
    card.querySelectorAll('.chip').forEach(x=>x.classList.toggle('sel',S.fork.sel[fk].includes(+x.dataset.ok)));
    SFX.play('flip');
  });
  fw.querySelectorAll('.card').forEach(card=>{
    const fk=+card.dataset.fk,f=DATA.forks[fk];
    if(S.fork.solved.includes(fk)){card.querySelector(`#ff${fk}`).innerHTML=`<span class="okc">Right.</span> <span class="mute small">${esc(f.why)}</span>`;return}
    const fb=card.querySelector(`#ff${fk}`);
    const check=()=>{
      const sel=S.fork.sel[fk]||[];
      if(sel.length!==3){fb.insertAdjacentHTML('beforeend',` <span class="mute">Pick exactly three.</span>`);return}
      if(!sel.includes(f.odd)){
        if(!S.fork.solved.includes(fk))S.fork.solved.push(fk);
        card.style.background='var(--ok-soft)';card.querySelectorAll('.chip').forEach(x=>x.disabled=true);
        fb.className='fb show';fb.innerHTML=`<span class="okc">Right.</span> <span class="mute small">${esc(f.why)}</span>`;
        SFX.play('right');save();drawBadges();if(S.fork.solved.length===DATA.forks.length&&S.build.solved.length===DATA.build.length)celebrate('s4');
      }else{
        card.classList.remove('shake');void card.offsetWidth;card.classList.add('shake');SFX.play('wrong');
        fb.className='fb show';fb.innerHTML=`<span style="color:var(--bad);font-weight:800">Not quite.</span> <span class="mute small">${esc(f.why)}</span> <button type="button" class="btn sm ghost">Try again</button>`;
        fb.querySelector('button').onclick=()=>{fb.className='fb';fb.innerHTML='<button type="button" class="btn sm">Check</button>';fb.querySelector('button').onclick=check;};
      }
    };
    fb.innerHTML='<button type="button" class="btn sm">Check</button>';
    fb.querySelector('button').onclick=check;
  });
  /* Part B */
  const bw=$('#builds');
  DATA.build.forEach((b,bk)=>{
    const solved=S.build.solved.includes(bk);
    const isAnswerOrder=o=>o&&b.ans.every((tk,j)=>o[j]===tk);
    if(!S.build.tiles[bk]||(!solved&&isAnswerOrder(S.build.tiles[bk]))){do{S.build.tiles[bk]=shuffle(b.tiles.map((_,k)=>k))}while(isAnswerOrder(S.build.tiles[bk]))}
    const order=S.build.tiles[bk];
    bw.insertAdjacentHTML('beforeend',
     `<div class="card" style="${solved?'background:var(--ok-soft)':''}" data-bk="${bk}">
        <div style="font-size:17px;line-height:1.5;margin-bottom:8px">${esc(b.cue)}</div>
        <div class="slot row" data-slot style="gap:6px;min-height:44px;border-bottom:2.5px dashed var(--mute);padding-bottom:6px;margin-bottom:10px"></div>
        <div class="row" data-tray style="gap:6px">${order.map((tk,pos)=>`<button type="button" class="chip" data-tk="${tk}" data-pos="${pos}" ${solved?'disabled':''}>${esc(b.tiles[tk])}</button>`).join('')}</div>
        <div class="row" style="margin-top:8px"><button type="button" class="btn sm" data-chk ${solved?'disabled':''}>Check</button><button type="button" class="btn sm ghost" data-clr ${solved?'disabled':''}>Clear</button></div>
        <div class="fb" data-fb></div></div>`);
    const card=bw.querySelector(`[data-bk="${bk}"]`),slot=card.querySelector('[data-slot]'),fb=card.querySelector('[data-fb]');